rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /usernames/{usernameLower} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }


    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId) && request.resource.data.uid == userId;

      function followingCountMutationIsAtomic() {
        let opAfter = getAfter(
          /databases/$(database)/documents/users/$(userId)/followOps/$(userId)
        );
        let targetId = opAfter == null ? '' : opAfter.data.targetId;

        return opAfter != null
          && opAfter.data.targetId is string
          && (
            (
              opAfter.data.type == 'follow'
              && !exists(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && request.resource.data.get('followingCount', 0)
                == resource.data.get('followingCount', 0) + 1
            )
            || (
              opAfter.data.type == 'unfollow'
              && exists(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && resource.data.get('followingCount', 0) > 0
              && request.resource.data.get('followingCount', 0)
                == resource.data.get('followingCount', 0) - 1
            )
          );
      }

      // Profile fields remain writable by the owner, except followersCount.
      // followersCount can only change with the matching relationship writes.
      allow update: if isAuthenticated() && (
        (
          isUser(userId)
          && resource.data.get('uid', userId) == userId
          && request.resource.data.get('uid', userId) == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['followersCount', 'followingCount'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followingCount'])
          && followingCountMutationIsAtomic()
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followersCount'])
          && (
            (
              resource.data.get('followersCount', 0) == 0
              && request.resource.data.get('followersCount', 0) == 1
            )
            || (
              resource.data.get('followersCount', 0) > 0
              && request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) + 1
            )
            || (
              resource.data.get('followersCount', 0) > 0
              && request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) - 1
            )
          )
          && (
            (
              request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) + 1
              && !exists(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
            )
            || (
              request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) - 1
              && exists(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
            )
          )
        )
      );

      allow delete: if isUser(userId);

      match /followOps/{operationId} {
        allow read, delete: if false;

        allow create, update: if isUser(userId)
          && operationId == userId
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.targetId is string
          && (
            request.resource.data.type == 'follow'
            || request.resource.data.type == 'unfollow'
          )
          && (
            (
              request.resource.data.type == 'follow'
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(request.resource.data.targetId)
              )
            )
            || (
              request.resource.data.type == 'unfollow'
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(request.resource.data.targetId)
              )
            )
          );
      }

      match /blockedUsers/{blockedId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow write: if isUser(userId);
      }


      match /followers/{followerId} {
        allow read: if isAuthenticated();

        allow create: if isUser(followerId)
          && request.resource.data.followerId == followerId
          && existsAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          )
          && (
            (
              get(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('followersCount', 0) == 0
              && getAfter(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('followersCount', 0) == 1
            )
            || (
              get(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('followersCount', 0) > 0
              && getAfter(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('followersCount', 0)
                == get(
                  /databases/$(database)/documents/users/$(userId)
                ).data.get('followersCount', 0) + 1
            )
          );

        allow delete: if isUser(followerId)
          && !existsAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          )
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.get('followersCount', 0) > 0
          && getAfter(
            /databases/$(database)/documents/users/$(userId)
          ).data.get('followersCount', 0)
            == get(
              /databases/$(database)/documents/users/$(userId)
            ).data.get('followersCount', 0) - 1;
      }

      match /following/{followingId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && request.resource.data.followingId == followingId
          && existsAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          );

        allow delete: if isUser(userId)
          && !existsAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          );
      }

      match /friends/{friendId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isUser(userId) || request.auth.uid == friendId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isUser(userId);
      }
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();

      function commentsCountMutationIsAtomic() {
        let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
        let opAfter = getAfter(opPath);
        let targetId = opAfter == null ? "" : opAfter.data.targetId;
        let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(targetId);
        return opAfter != null
          && targetId is string
          && (
            (
              (
                resource.data.commentsCount == null
                && request.resource.data.commentsCount == 1
              )
              || (
                resource.data.commentsCount != null
                && request.resource.data.commentsCount == resource.data.commentsCount + 1
              )
            )
            && opAfter.data.type == 'comment_create'
            && !exists(commentPath)
            && existsAfter(commentPath)
          )
          || (
            resource.data.commentsCount != null
            && resource.data.commentsCount > 0
            && request.resource.data.commentsCount == resource.data.commentsCount - 1
            && opAfter.data.type == 'comment_delete'
            && exists(commentPath)
            && !existsAfter(commentPath)
          );
      }

      function validRepostCreate() {
        let originalId = request.resource.data.originalPostId;
        let originalPath = /databases/$(database)/documents/posts/$(originalId);
        let markerPath = /databases/$(database)/documents/posts/$(originalId)/reposts/$(request.auth.uid);
        return originalId is string
          && exists(originalPath)
          && existsAfter(markerPath)
          && getAfter(markerPath).data.repostId == postId
          && (
            (
              get(originalPath).data.repostsCount == null
              && getAfter(originalPath).data.repostsCount == 1
            )
            || (
              get(originalPath).data.repostsCount != null
              && getAfter(originalPath).data.repostsCount
                == get(originalPath).data.repostsCount + 1
            )
          );
      }

      // Counter fields are forced to zero for all new client-created posts.
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.repostsCount == 0
        && (
          request.resource.data.isRepost != true
          || validRepostCreate()
        );

      // Normal posts can be deleted by their author. A repost must remove its
      // marker and decrement the original counter in the same atomic operation.
      allow delete: if isAuthenticated()
        && resource.data.authorId == request.auth.uid
        && (
          resource.data.isRepost != true
          || (
            resource.data.originalPostId is string
            && (
              !exists(
                /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
              )
              || (
                exists(
                  /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                )
                && get(
                  /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                ).data.repostId == postId
                && !existsAfter(
                  /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                )
                && get(/databases/$(database)/documents/posts/$(resource.data.originalPostId)).data.repostsCount != null
                && get(/databases/$(database)/documents/posts/$(resource.data.originalPostId)).data.repostsCount > 0
                && getAfter(/databases/$(database)/documents/posts/$(resource.data.originalPostId)).data.repostsCount
                  == get(/databases/$(database)/documents/posts/$(resource.data.originalPostId)).data.repostsCount - 1
              )
            )
          )
        );

      // Post authors may edit content but cannot directly change counters.
      // Counter changes are coupled to the corresponding interaction.
      allow update: if isAuthenticated() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['likesCount', 'commentsCount', 'repostsCount'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && (
            (
              resource.data.likesCount == null
              && request.resource.data.likesCount == 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
            || (
              resource.data.likesCount != null
              && request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
            || (
              resource.data.likesCount != null
              && resource.data.likesCount > 0
              && request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && commentsCountMutationIsAtomic()
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostsCount'])
          && (
            (
              (
                resource.data.repostsCount == null
                && request.resource.data.repostsCount == 1
              )
              || (
                resource.data.repostsCount != null
                && request.resource.data.repostsCount == resource.data.repostsCount + 1
              )
            )
            && !exists(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
          )
          || (
            resource.data.repostsCount != null
            && resource.data.repostsCount > 0
            && request.resource.data.repostsCount == resource.data.repostsCount - 1
            && exists(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
          )
        )
      );

      match /likes/{userId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && request.resource.data.keys().hasOnly(['likedAt'])
          && (
            (
              get(/databases/$(database)/documents/posts/$(postId)).data.likesCount == null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == 1
            )
            || (
              get(/databases/$(database)/documents/posts/$(postId)).data.likesCount != null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
                == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount + 1
            )
          );

        allow delete: if isUser(userId)
          && get(/databases/$(database)/documents/posts/$(postId)).data.likesCount != null
          && get(/databases/$(database)/documents/posts/$(postId)).data.likesCount > 0
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
            == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount - 1;
      }

      // Internal client transaction marker. It is never readable or directly deletable.
      match /counterOps/{userId} {
        allow read: if false;
        allow delete: if false;

        allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.targetId is string
          && (
            (
              request.resource.data.type == 'comment_create'
              && !exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && existsAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && getAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              ).data.authorId == request.auth.uid
            )
            || (
              request.resource.data.type == 'comment_delete'
              && exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && !existsAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && (
                get(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
                ).data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
              )
            )
          );
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();

        function commentCreateIsAtomic(targetCommentId) {
          let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
          let postPath = /databases/$(database)/documents/posts/$(postId);
          let opAfter = getAfter(opPath);
          let oldCount = get(postPath).data.commentsCount;
          let newCount = getAfter(postPath).data.commentsCount;
          return opAfter != null
            && opAfter.data.type == 'comment_create'
            && opAfter.data.targetId == targetCommentId
            && (
              (oldCount == null && newCount == 1)
              || (oldCount != null && newCount == oldCount + 1)
            );
        }

        function commentDeleteIsAtomic(targetCommentId) {
          let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
          let postPath = /databases/$(database)/documents/posts/$(postId);
          let opAfter = getAfter(opPath);
          let oldCount = get(postPath).data.commentsCount;
          let newCount = getAfter(postPath).data.commentsCount;
          return opAfter != null
            && opAfter.data.type == 'comment_delete'
            && opAfter.data.targetId == targetCommentId
            && oldCount != null
            && oldCount > 0
            && newCount == oldCount - 1;
        }

        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.likesCount == 0
          && commentCreateIsAtomic(commentId);

        allow delete: if isAuthenticated()
          && (
            resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          )
          && commentDeleteIsAtomic(commentId);

        allow update: if isAuthenticated() && (
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'isEdited', 'editedAt'])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && (
              (
                resource.data.likesCount != null
                && request.resource.data.likesCount == resource.data.likesCount + 1
                && !exists(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
                && existsAfter(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
              )
              || (
                resource.data.likesCount != null
                && resource.data.likesCount > 0
                && request.resource.data.likesCount == resource.data.likesCount - 1
                && exists(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
                && !existsAfter(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
              )
            )
          )
        );

        match /likes/{userId} {
          allow read: if isAuthenticated();

          allow create: if isUser(userId)
            && request.resource.data.keys().hasOnly(['likedAt'])
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount
              == get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
              ).data.likesCount + 1;

          allow delete: if isUser(userId)
            && get(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount > 0
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount
              == get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
              ).data.likesCount - 1;
        }
      }

      // One repost marker per user per original post.
      match /reposts/{userId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && request.resource.data.keys().hasOnly(['postId', 'reposterId', 'repostId', 'createdAt'])
          && request.resource.data.postId == postId
          && request.resource.data.reposterId == userId
          && request.resource.data.repostId is string
          && existsAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          )
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.authorId == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.isRepost == true
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.originalPostId == postId
          && (
            (
              get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount == null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.repostsCount == 1
            )
            || (
              get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount != null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.repostsCount
                == get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount + 1
            )
          );

        allow delete: if isUser(userId)
          && resource.data.repostId is string
          && !existsAfter(
            /databases/$(database)/documents/posts/$(resource.data.repostId)
          )
          && get(
            /databases/$(database)/documents/posts/$(postId)
          ).data.repostsCount > 0
          && getAfter(
            /databases/$(database)/documents/posts/$(postId)
          ).data.repostsCount
            == get(
              /databases/$(database)/documents/posts/$(postId)
            ).data.repostsCount - 1;
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuthenticated()
          && resource.data.participantIds is list
          && resource.data.participantIds.hasAny([request.auth.uid]);
      }

      function isValidConversationCreate() {
        return isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'participantIds',
            'participantsInfo',
            'lastMessageText',
            'lastMessageAt',
            'lastMessageSenderId',
            'unreadCount'
          ])
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 2
          && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
          && request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.participantsInfo is map
          && request.resource.data.participantsInfo.keys().hasOnly([
            request.resource.data.participantIds[0],
            request.resource.data.participantIds[1]
          ])
          && request.resource.data.unreadCount is map
          && request.resource.data.unreadCount.keys().hasOnly([
            request.resource.data.participantIds[0],
            request.resource.data.participantIds[1]
          ])
          && request.resource.data.unreadCount[request.resource.data.participantIds[0]] == 0
          && request.resource.data.unreadCount[request.resource.data.participantIds[1]] == 0
          && request.resource.data.lastMessageText == ''
          && request.resource.data.lastMessageSenderId == ''
          && request.resource.data.lastMessageAt is timestamp;
      }

      function messagePath(messageId) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
      }

      function messageOpPath(uid) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messageOps/$(uid);
      }


      function sendMetadataIsAtomic() {
        let opAfter = getAfter(messageOpPath(request.auth.uid));
        let targetId = opAfter == null ? '' : opAfter.data.targetId;
        let newMessage = opAfter == null || targetId == ''
          ? null
          : getAfter(messagePath(targetId));
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let oldOtherUnread = oldUnread is map
          ? oldUnread.get(otherUid, 0)
          : 0;
        let oldOwnUnread = oldUnread is map
          ? oldUnread.get(request.auth.uid, 0)
          : 0;
        let newOtherUnread = newUnread is map
          ? newUnread.get(otherUid, 0)
          : 0;
        let newOwnUnread = newUnread is map
          ? newUnread.get(request.auth.uid, 0)
          : 0;
        let expectedPreview = newMessage == null
          ? ''
          : (
              newMessage.data.text != null && newMessage.data.text != ''
                ? newMessage.data.text
                : (
                    newMessage.data.imageUrl != null && newMessage.data.imageUrl != ''
                      ? '📷 Photo'
                      : ''
                  )
            );

        return opAfter != null
          && opAfter.data.type == 'send'
          && opAfter.data.targetId is string
          && newMessage != null
          && newMessage.data.senderId == request.auth.uid
          && newMessage.data.createdAt == request.time
          && newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newOwnUnread == oldOwnUnread
          && newOtherUnread == oldOtherUnread + 1
          && request.resource.data.lastMessageText == expectedPreview
          && request.resource.data.lastMessageAt == newMessage.data.createdAt
          && request.resource.data.lastMessageSenderId == request.auth.uid;
      }

      function unreadCountResetIsSafe() {
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let oldOtherUnread = oldUnread is map
          ? oldUnread.get(otherUid, 0)
          : 0;
        let newOtherUnread = newUnread is map
          ? newUnread.get(otherUid, 0)
          : 0;
        let newOwnUnread = newUnread is map
          ? newUnread.get(request.auth.uid, 0)
          : 0;

        return newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newOwnUnread == 0
          && newOtherUnread == oldOtherUnread
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount']);
      }

      allow read: if isParticipant();

      allow create: if isValidConversationCreate();

      allow update: if isParticipant() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageText',
            'lastMessageAt',
            'lastMessageSenderId',
            'unreadCount'
          ])
          && sendMetadataIsAtomic()
        )
        || unreadCountResetIsSafe()
      );

      allow delete: if isParticipant();

      match /messageOps/{userId} {
        function parentConversationIsAccessible() {
          let conversation = get(
            /databases/$(database)/documents/conversations/$(conversationId)
          );
          return isAuthenticated()
            && conversation != null
            && conversation.data.participantIds is list
            && conversation.data.participantIds.hasAny([request.auth.uid]);
        }

        allow read, delete: if false;

        allow create, update: if isUser(userId)
          && parentConversationIsAccessible()
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.type == 'send'
          && request.resource.data.targetId is string
          && !exists(messagePath(request.resource.data.targetId))
          && existsAfter(messagePath(request.resource.data.targetId))
          && getAfter(messagePath(request.resource.data.targetId)).data.senderId == request.auth.uid;
      }

      match /messages/{messageId} {
        function parentConversationIsAccessible() {
          let conversation = get(
            /databases/$(database)/documents/conversations/$(conversationId)
          );
          return isAuthenticated()
            && conversation != null
            && conversation.data.participantIds is list
            && conversation.data.participantIds.hasAny([request.auth.uid]);
        }

        function validMessageFields() {
          return request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'imageUrl',
            'createdAt',
            'status'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'sent'
          && (
            request.resource.data.text == null
            || request.resource.data.text is string
          )
          && (
            request.resource.data.imageUrl == null
            || request.resource.data.imageUrl is string
          )
          && (
            (
              request.resource.data.text is string
              && request.resource.data.text != ''
            )
            || (
              request.resource.data.imageUrl is string
              && request.resource.data.imageUrl != ''
            )
          );
        }

        function sendMarkerMatchesMessage() {
          let opAfter = getAfter(messageOpPath(request.auth.uid));
          return opAfter != null
            && opAfter.data.type == 'send'
            && opAfter.data.targetId == messageId
            && !exists(messagePath(messageId))
            && existsAfter(messagePath(messageId));
        }

        allow read: if parentConversationIsAccessible();

        allow create: if parentConversationIsAccessible()
          && validMessageFields()
          && sendMarkerMatchesMessage();

        // Individual message deletion is not permitted. Conversation deletion
        // is the only client-side deletion path and must delete messages and
        // the parent conversation in the same batch.
        allow delete: if parentConversationIsAccessible()
          && !existsAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          );

        allow update: if parentConversationIsAccessible() && (
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'imageUrl'])
            && (
              request.resource.data.text == null
              || request.resource.data.text is string
            )
            && (
              request.resource.data.imageUrl == null
              || request.resource.data.imageUrl is string
            )
            && (
              (
                request.resource.data.text is string
                && request.resource.data.text != ''
              )
              || (
                request.resource.data.imageUrl is string
                && request.resource.data.imageUrl != ''
              )
            )
          )
          || (
            resource.data.senderId != request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.text == resource.data.text
            && request.resource.data.imageUrl == resource.data.imageUrl
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
            && request.resource.data.status == 'read'
            && (
              resource.data.status == 'sent'
              || resource.data.status == 'delivered'
            )
          )
        );
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
    }
  }
}
