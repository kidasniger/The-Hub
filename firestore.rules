rules_version = '2';
// Production rules are deployed by the Firebase Admin SDK CI workflow.
// Deployment verification trigger: keep production rules synchronized with main.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    // Only the verified Google account with the exact bootstrap email may
    // create its own initial admin document.
    function isBootstrapAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'kidasniger@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());

      // Existing administrators may promote additional accounts.
      // The bootstrap account may only create its own administrator document,
      // with a tightly constrained set of fields.
      allow create: if (
        isAdmin()
        && request.resource.data.uid == adminId
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
      ) || (
        isBootstrapAdmin()
        && adminId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'active',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == 'kidasniger@gmail.com'
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
      );

      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active', 'displayName', 'email']);

      allow delete: if isAdmin() && adminId != request.auth.uid;
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }


    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId) && request.resource.data.uid == userId;

      function followingCountMutationIsAtomic() {
        let opAfter = getAfter(
          /databases/$(database)/documents/users/$(userId)/followOps/$(userId)
        );
        let targetId = opAfter == null ? '' : opAfter.data.targetId;

        return opAfter != null
          && opAfter.data.targetId is string
          && (
            (
              opAfter.data.type == 'follow'
              && !exists(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && request.resource.data.get('followingCount', 0)
                == resource.data.get('followingCount', 0) + 1
            )
            || (
              opAfter.data.type == 'unfollow'
              && exists(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(targetId)
              )
              && resource.data.get('followingCount', 0) > 0
              && request.resource.data.get('followingCount', 0)
                == resource.data.get('followingCount', 0) - 1
            )
          );
      }

      // Profile fields remain writable by the owner, except followersCount.
      // followersCount can only change with the matching relationship writes.
      allow update: if isAuthenticated() && (
        (
          isUser(userId)
          && resource.data.get('uid', userId) == userId
          && request.resource.data.get('uid', userId) == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['followersCount', 'followingCount', 'isDeleted', 'isSuspended'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followingCount'])
          && followingCountMutationIsAtomic()
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followersCount'])
          && (
            (
              resource.data.get('followersCount', 0) == 0
              && request.resource.data.get('followersCount', 0) == 1
            )
            || (
              resource.data.get('followersCount', 0) > 0
              && request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) + 1
            )
            || (
              resource.data.get('followersCount', 0) > 0
              && request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) - 1
            )
          )
          && (
            (
              request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) + 1
              && !exists(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
            )
            || (
              request.resource.data.get('followersCount', 0)
                == resource.data.get('followersCount', 0) - 1
              && exists(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
            )
          )
        )
      )
        || (
          isAdmin()
          && userId != request.auth.uid
          && request.resource.data.get('uid', userId) == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isDeleted'])
        )
        || (
          isAdmin()
          && userId != request.auth.uid
          && request.resource.data.get('uid', userId) == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isSuspended'])
        );

      allow delete: if isUser(userId);

      match /followOps/{operationId} {
        allow read, delete: if false;

        allow create, update: if isUser(userId)
          && operationId == userId
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.targetId is string
          && (
            request.resource.data.type == 'follow'
            || request.resource.data.type == 'unfollow'
          )
          && (
            (
              request.resource.data.type == 'follow'
              && existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(request.resource.data.targetId)
              )
            )
            || (
              request.resource.data.type == 'unfollow'
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(request.resource.data.targetId)
              )
            )
          );
      }

      match /blockedUsers/{blockedId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow write: if isUser(userId);
      }


      match /followers/{followerId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && userId != followerId
          && isUser(followerId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(followerId))
          && request.resource.data.keys().hasOnly(['followedAt', 'followerId', 'uid'])
          && request.resource.data.followerId == followerId
          && request.resource.data.uid == followerId
          && request.resource.data.followedAt is timestamp
          && existsAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          )
          && getAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          ).data.followingId == userId
          && getAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          ).data.uid == userId
          && (
            (
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('followersCount', 0) == 0
              && getAfter(/databases/$(database)/documents/users/$(userId))
                .data.get('followersCount', 0) == 1
            )
            || (
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('followersCount', 0) > 0
              && getAfter(/databases/$(database)/documents/users/$(userId))
                .data.get('followersCount', 0)
                == get(/databases/$(database)/documents/users/$(userId))
                  .data.get('followersCount', 0) + 1
            )
          );

        allow update: if false;

        allow delete: if isAuthenticated()
          && userId != followerId
          && isUser(followerId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(followerId))
          && resource.data.followerId == followerId
          && resource.data.uid == followerId
          && !existsAfter(
            /databases/$(database)/documents/users/$(followerId)/following/$(userId)
          )
          && get(/databases/$(database)/documents/users/$(userId))
            .data.get('followersCount', 0) > 0
          && getAfter(/databases/$(database)/documents/users/$(userId))
            .data.get('followersCount', 0)
            == get(/databases/$(database)/documents/users/$(userId))
              .data.get('followersCount', 0) - 1;
      }

      match /following/{followingId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && userId != followingId
          && isUser(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(followingId))
          && request.resource.data.keys().hasOnly(['followedAt', 'followingId', 'uid'])
          && request.resource.data.followingId == followingId
          && request.resource.data.uid == followingId
          && request.resource.data.followedAt is timestamp
          && existsAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          )
          && getAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          ).data.followerId == userId
          && getAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          ).data.uid == userId;

        allow update: if false;

        allow delete: if isAuthenticated()
          && userId != followingId
          && isUser(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(followingId))
          && resource.data.followingId == followingId
          && resource.data.uid == followingId
          && !existsAfter(
            /databases/$(database)/documents/users/$(followingId)/followers/$(userId)
          );
      }

      match /friends/{friendId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && userId != friendId
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(friendId))
          && request.resource.data.keys().hasOnly(['friendedAt', 'uid'])
          && request.resource.data.uid == friendId
          && request.resource.data.friendedAt is timestamp
          && exists(/databases/$(database)/documents/users/$(userId)/following/$(friendId))
          && exists(/databases/$(database)/documents/users/$(friendId)/following/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)/following/$(friendId))
            .data.followingId == friendId
          && get(/databases/$(database)/documents/users/$(userId)/following/$(friendId))
            .data.uid == friendId
          && get(/databases/$(database)/documents/users/$(friendId)/following/$(userId))
            .data.followingId == userId
          && get(/databases/$(database)/documents/users/$(friendId)/following/$(userId))
            .data.uid == userId;

        allow update: if isAuthenticated()
          && userId != friendId
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(friendId))
          && resource.data.uid == friendId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendedAt'])
          && request.resource.data.friendedAt is timestamp
          && exists(/databases/$(database)/documents/users/$(userId)/following/$(friendId))
          && exists(/databases/$(database)/documents/users/$(friendId)/following/$(userId));

        allow delete: if isAuthenticated()
          && userId != friendId
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && resource.data.uid == friendId
          && (
            (
              request.auth.uid == userId
              && !existsAfter(
                /databases/$(database)/documents/users/$(userId)/following/$(friendId)
              )
            )
            || (
              request.auth.uid == friendId
              && !existsAfter(
                /databases/$(database)/documents/users/$(friendId)/following/$(userId)
              )
            )
          );
      }

      match /bookmarks/{bookmarkId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && exists(/databases/$(database)/documents/posts/$(bookmarkId))
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt is timestamp;

        allow update: if isUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAt'])
          && request.resource.data.savedAt is timestamp;

        allow delete: if isUser(userId);
      }
      match /presence/{presenceId} {
        allow read: if isAuthenticated();

        allow create, update: if isUser(userId)
          && presenceId == 'current'
          && request.resource.data.keys().hasOnly(['userId', 'online', 'lastSeen'])
          && request.resource.data.userId == userId
          && request.resource.data.online is bool
          && request.resource.data.lastSeen is timestamp;

        allow delete: if isUser(userId) && presenceId == 'current';
      }

      match /fcmTokens/{tokenId} {
        // Tokens are private device credentials. They are never readable by
        // clients and can only be created/updated/deleted by their owner.
        allow read: if false;

        allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'appVersion',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt is timestamp;

        allow delete: if isUser(userId);
      }
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();

      function commentsCountMutationIsAtomic() {
        let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
        let opAfter = getAfter(opPath);
        let targetId = opAfter == null ? "" : opAfter.data.targetId;
        let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(targetId);
        return opAfter != null
          && targetId is string
          && (
            (
              (
                resource.data.commentsCount == null
                && request.resource.data.commentsCount == 1
              )
              || (
                resource.data.commentsCount != null
                && request.resource.data.commentsCount == resource.data.commentsCount + 1
              )
            )
            && opAfter.data.type == 'comment_create'
            && !exists(commentPath)
            && existsAfter(commentPath)
          )
          || (
            resource.data.commentsCount != null
            && resource.data.commentsCount > 0
            && request.resource.data.commentsCount == resource.data.commentsCount - 1
            && opAfter.data.type == 'comment_delete'
            && exists(commentPath)
            && !existsAfter(commentPath)
          );
      }

      function validRepostCreate() {
        let originalId = request.resource.data.originalPostId;
        let originalPath = /databases/$(database)/documents/posts/$(originalId);
        let markerPath = /databases/$(database)/documents/posts/$(originalId)/reposts/$(request.auth.uid);
        return originalId is string
          && exists(originalPath)
          && existsAfter(markerPath)
          && getAfter(markerPath).data.repostId == postId
          && (
            (
              get(originalPath).data.repostsCount == null
              && getAfter(originalPath).data.repostsCount == 1
            )
            || (
              get(originalPath).data.repostsCount != null
              && getAfter(originalPath).data.repostsCount
                == get(originalPath).data.repostsCount + 1
            )
          );
      }

      // Counter fields are forced to zero for all new client-created posts.
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.repostsCount == 0
        && (
          request.resource.data.isRepost != true
          || validRepostCreate()
        );

      // Normal posts can be deleted by their author. Administrators can
      // delete any post for moderation. Reposts must keep the original counter
      // and marker consistent when the author deletes them.
      allow delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && (
            resource.data.isRepost != true
            || (
              resource.data.originalPostId is string
              && (
                !exists(
                  /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                )
                || (
                  exists(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                  )
                  && get(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                  ).data.repostId == postId
                  && !existsAfter(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)/reposts/$(request.auth.uid)
                  )
                  && get(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)
                  ).data.repostsCount != null
                  && get(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)
                  ).data.repostsCount > 0
                  && getAfter(
                    /databases/$(database)/documents/posts/$(resource.data.originalPostId)
                  ).data.repostsCount
                    == get(
                      /databases/$(database)/documents/posts/$(resource.data.originalPostId)
                    ).data.repostsCount - 1
                )
              )
            )
          )
        );

      // Post authors may edit content but cannot directly change counters.
      // Counter changes are coupled to the corresponding interaction.
      allow update: if isAuthenticated() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['likesCount', 'commentsCount', 'repostsCount'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && (
            (
              resource.data.likesCount == null
              && request.resource.data.likesCount == 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
            || (
              resource.data.likesCount != null
              && request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
            || (
              resource.data.likesCount != null
              && resource.data.likesCount > 0
              && request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && commentsCountMutationIsAtomic()
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostsCount'])
          && (
            (
              (
                resource.data.repostsCount == null
                && request.resource.data.repostsCount == 1
              )
              || (
                resource.data.repostsCount != null
                && request.resource.data.repostsCount == resource.data.repostsCount + 1
              )
            )
            && !exists(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
          )
          || (
            resource.data.repostsCount != null
            && resource.data.repostsCount > 0
            && request.resource.data.repostsCount == resource.data.repostsCount - 1
            && exists(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/posts/$(postId)/reposts/$(request.auth.uid))
          )
        )
      );

      match /likes/{userId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(['likedAt'])
          && request.resource.data.likedAt is timestamp
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId is string
          && exists(
            /databases/$(database)/documents/users/$(get(/databases/$(database)/documents/posts/$(postId)).data.authorId)
          )
          && (
            (
              get(/databases/$(database)/documents/posts/$(postId)).data.likesCount == null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == 1
            )
            || (
              get(/databases/$(database)/documents/posts/$(postId)).data.likesCount != null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
                == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount + 1
            )
          );

        allow update: if false;

        allow delete: if isUser(userId)
          && resource.data.keys().hasOnly(['likedAt'])
          && resource.data.likedAt is timestamp
          && get(/databases/$(database)/documents/posts/$(postId)).data.likesCount != null
          && get(/databases/$(database)/documents/posts/$(postId)).data.likesCount > 0
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
            == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount - 1;
      }

      // Internal client transaction marker. It is never readable or directly deletable.
      match /counterOps/{userId} {
        allow read: if false;
        allow delete: if false;

        allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.targetId is string
          && (
            (
              request.resource.data.type == 'comment_create'
              && !exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && existsAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && getAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              ).data.authorId == request.auth.uid
            )
            || (
              request.resource.data.type == 'comment_delete'
              && exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && !existsAfter(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
              )
              && (
                get(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.targetId)
                ).data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
              )
            )
          );
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();

        function commentCreateIsAtomic(targetCommentId) {
          let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
          let postPath = /databases/$(database)/documents/posts/$(postId);
          let opAfter = getAfter(opPath);
          let oldCount = get(postPath).data.commentsCount;
          let newCount = getAfter(postPath).data.commentsCount;
          return opAfter != null
            && opAfter.data.type == 'comment_create'
            && opAfter.data.targetId == targetCommentId
            && (
              (oldCount == null && newCount == 1)
              || (oldCount != null && newCount == oldCount + 1)
            );
        }

        function commentDeleteIsAtomic(targetCommentId) {
          let opPath = /databases/$(database)/documents/posts/$(postId)/counterOps/$(request.auth.uid);
          let postPath = /databases/$(database)/documents/posts/$(postId);
          let opAfter = getAfter(opPath);
          let oldCount = get(postPath).data.commentsCount;
          let newCount = getAfter(postPath).data.commentsCount;
          return opAfter != null
            && opAfter.data.type == 'comment_delete'
            && opAfter.data.targetId == targetCommentId
            && oldCount != null
            && oldCount > 0
            && newCount == oldCount - 1;
        }

        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.likesCount == 0
          && commentCreateIsAtomic(commentId);

        allow delete: if isAuthenticated()
          && (
            resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          )
          && commentDeleteIsAtomic(commentId);

        allow update: if isAuthenticated() && (
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'isEdited', 'editedAt'])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && (
              (
                resource.data.likesCount != null
                && request.resource.data.likesCount == resource.data.likesCount + 1
                && !exists(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
                && existsAfter(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
              )
              || (
                resource.data.likesCount != null
                && resource.data.likesCount > 0
                && request.resource.data.likesCount == resource.data.likesCount - 1
                && exists(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
                && !existsAfter(
                  /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid)
                )
              )
            )
          )
        );

        match /likes/{userId} {
          allow read: if isAuthenticated();

          allow create: if isUser(userId)
            && exists(/databases/$(database)/documents/posts/$(postId))
            && exists(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            )
            && request.resource.data.keys().hasOnly(['likedAt'])
            && request.resource.data.likedAt is timestamp
            && get(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.authorId is string
            && exists(
              /databases/$(database)/documents/users/$(get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
              ).data.authorId)
            )
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount
              == get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
              ).data.likesCount + 1;

          allow update: if false;

          allow delete: if isUser(userId)
            && resource.data.keys().hasOnly(['likedAt'])
            && resource.data.likedAt is timestamp
            && get(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount > 0
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data.likesCount
              == get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
              ).data.likesCount - 1;
        }
      }

      // One repost marker per user per original post.
      match /reposts/{userId} {
        allow read: if isAuthenticated();

        allow create: if isUser(userId)
          && request.resource.data.keys().hasOnly(['postId', 'reposterId', 'repostId', 'createdAt'])
          && request.resource.data.postId == postId
          && request.resource.data.reposterId == userId
          && request.resource.data.repostId is string
          && existsAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          )
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.authorId == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.isRepost == true
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.repostId)
          ).data.originalPostId == postId
          && (
            (
              get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount == null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.repostsCount == 1
            )
            || (
              get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount != null
              && getAfter(/databases/$(database)/documents/posts/$(postId)).data.repostsCount
                == get(/databases/$(database)/documents/posts/$(postId)).data.repostsCount + 1
            )
          );

        allow delete: if isUser(userId)
          && resource.data.repostId is string
          && !existsAfter(
            /databases/$(database)/documents/posts/$(resource.data.repostId)
          )
          && get(
            /databases/$(database)/documents/posts/$(postId)
          ).data.repostsCount > 0
          && getAfter(
            /databases/$(database)/documents/posts/$(postId)
          ).data.repostsCount
            == get(
              /databases/$(database)/documents/posts/$(postId)
            ).data.repostsCount - 1;
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuthenticated()
          && resource.data.participantIds is list
          && resource.data.participantIds.hasAny([request.auth.uid]);
      }

      function isValidConversationCreate() {
        return isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'participantIds',
            'participantsInfo',
            'lastMessageText',
            'lastMessageAt',
            'lastMessageSenderId',
            'lastMessageId',
            'unreadCount'
          ])
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 2
          && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
          && request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.participantsInfo is map
          && request.resource.data.participantsInfo.keys().hasOnly([
            request.resource.data.participantIds[0],
            request.resource.data.participantIds[1]
          ])
          && request.resource.data.unreadCount is map
          && request.resource.data.unreadCount.keys().hasOnly([
            request.resource.data.participantIds[0],
            request.resource.data.participantIds[1]
          ])
          && request.resource.data.unreadCount[request.resource.data.participantIds[0]] == 0
          && request.resource.data.unreadCount[request.resource.data.participantIds[1]] == 0
          && request.resource.data.lastMessageText == ''
          && request.resource.data.lastMessageSenderId == ''
          && request.resource.data.get('lastMessageId', '') == ''
          && request.resource.data.lastMessageAt is timestamp;
      }

      function canAccessConversation() {
        let conversation = get(
          /databases/$(database)/documents/conversations/$(conversationId)
        );
        return isAuthenticated()
          && conversation != null
          && conversation.data.participantIds is list
          && conversation.data.participantIds.hasAny([request.auth.uid]);
      }

      function messagePath(messageId) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
      }

      function messageOpPath(uid) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messageOps/$(uid);
      }

      function canMessagePair(senderUid, targetUid) {
        return senderUid != targetUid
          && (
            exists(
              /databases/$(database)/documents/users/$(senderUid)/friends/$(targetUid)
            )
            || exists(
              /databases/$(database)/documents/users/$(senderUid)/following/$(targetUid)
            )
            || exists(
              /databases/$(database)/documents/users/$(targetUid)/followers/$(senderUid)
            )
          );
      }

      function canMessageTargetOnCreate() {
        let targetUid = request.resource.data.participantIds[0] == request.auth.uid
          ? request.resource.data.participantIds[1]
          : request.resource.data.participantIds[0];

        return canMessagePair(request.auth.uid, targetUid);
      }

      function canMessageOtherUser() {
        let conversation = get(
          /databases/$(database)/documents/conversations/$(conversationId)
        );
        let otherUid = conversation.data.participantIds[0] == request.auth.uid
          ? conversation.data.participantIds[1]
          : conversation.data.participantIds[0];

        return canMessagePair(request.auth.uid, otherUid);
      }

      function sendMetadataIsAtomic() {
        let opAfter = getAfter(messageOpPath(request.auth.uid));
        let targetId = opAfter == null ? '' : opAfter.data.targetId;
        let newMessage = opAfter == null || targetId == ''
          ? null
          : getAfter(messagePath(targetId));
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let oldOtherUnread = oldUnread is map
          ? oldUnread.get(otherUid, 0)
          : 0;
        let oldOwnUnread = oldUnread is map
          ? oldUnread.get(request.auth.uid, 0)
          : 0;
        let newOtherUnread = newUnread is map
          ? newUnread.get(otherUid, 0)
          : 0;
        let newOwnUnread = newUnread is map
          ? newUnread.get(request.auth.uid, 0)
          : 0;
        let expectedPreview = newMessage == null
          ? ''
          : (
              newMessage.data.text != null && newMessage.data.text != ''
                ? newMessage.data.text
                : (
                    newMessage.data.imageUrl != null && newMessage.data.imageUrl != ''
                      ? '📷 Photo'
                      : ''
                  )
            );

        return opAfter != null
          && opAfter.data.type == 'send'
          && opAfter.data.targetId is string
          && newMessage != null
          && newMessage.data.senderId == request.auth.uid
          && newMessage.data.createdAt == request.time
          && newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newOwnUnread == oldOwnUnread
          && newOtherUnread == oldOtherUnread + 1
          && request.resource.data.lastMessageText == expectedPreview
          && request.resource.data.lastMessageAt == newMessage.data.createdAt
          && request.resource.data.lastMessageSenderId == request.auth.uid;
      }

      function sendMetadataIsAtomicByMessageId() {
        let messageId = request.resource.data.get('lastMessageId', '');
        let newMessage = messageId is string && messageId != ''
          ? getAfter(messagePath(messageId))
          : null;
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let oldOtherUnread = oldUnread is map
          ? oldUnread.get(otherUid, 0)
          : 0;
        let oldOwnUnread = oldUnread is map
          ? oldUnread.get(request.auth.uid, 0)
          : 0;
        let newOtherUnread = newUnread is map
          ? newUnread.get(otherUid, 0)
          : 0;
        let newOwnUnread = newUnread is map
          ? newUnread.get(request.auth.uid, 0)
          : 0;
        let expectedPreview = newMessage == null
          ? ''
          : (
              newMessage.data.text != null && newMessage.data.text != ''
                ? newMessage.data.text
                : (
                    newMessage.data.imageUrl != null && newMessage.data.imageUrl != ''
                      ? '📷 Photo'
                      : ''
                  )
            );

        return newMessage != null
          && newMessage.data.senderId == request.auth.uid
          && newMessage.data.createdAt == request.time
          && newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newOwnUnread == oldOwnUnread
          && newOtherUnread == oldOtherUnread + 1
          && request.resource.data.lastMessageText == expectedPreview
          && request.resource.data.lastMessageAt == newMessage.data.createdAt
          && request.resource.data.lastMessageSenderId == request.auth.uid
          && request.resource.data.lastMessageId == messageId;
      }

      function sendMetadataIsDirectSafe() {
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let newText = request.resource.data.get('lastMessageText', '');
        let newAt = request.resource.data.get('lastMessageAt', null);
        let newSender = request.resource.data.get('lastMessageSenderId', '');
        let newId = request.resource.data.get('lastMessageId', '');

        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageText',
            'lastMessageAt',
            'lastMessageSenderId',
            'lastMessageId',
            'unreadCount'
          ])
          && newText is string
          && newSender == request.auth.uid
          && newAt == request.time
          && newId is string
          && newId != ''
          && newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newUnread.get(request.auth.uid, 0) == (
            oldUnread is map
              ? oldUnread.get(request.auth.uid, 0)
              : 0
          )
          && newUnread.get(otherUid, 0) == (
            (oldUnread is map ? oldUnread.get(otherUid, 0) : 0) + 1
          );
      }

      function unreadCountResetIsSafe() {
        let otherUid = resource.data.participantIds[0] == request.auth.uid
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let oldUnread = resource.data.get('unreadCount', {});
        let newUnread = request.resource.data.get('unreadCount', {});
        let oldOtherUnread = oldUnread is map
          ? oldUnread.get(otherUid, 0)
          : 0;
        let newOtherUnread = newUnread is map
          ? newUnread.get(otherUid, 0)
          : 0;
        let newOwnUnread = newUnread is map
          ? newUnread.get(request.auth.uid, 0)
          : 0;

        return newUnread is map
          && newUnread.keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
          && newOwnUnread == 0
          && newOtherUnread == oldOtherUnread
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount']);
      }

      allow read: if isParticipant();

      allow create: if isValidConversationCreate()
        && canMessageTargetOnCreate();

      allow update: if isParticipant() && (
        (
          request.resource.data.get('lastMessageId', '') is string
          && request.resource.data.get('lastMessageId', '') != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageText',
            'lastMessageAt',
            'lastMessageSenderId',
            'lastMessageId',
            'unreadCount'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageText'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageSenderId'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageId'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadCount'])
          && request.resource.data.get('lastMessageSenderId', '') == request.auth.uid
          && request.resource.data.get('lastMessageAt', null) is timestamp
          && request.resource.data.get('lastMessageText', '') is string
          && request.resource.data.get('unreadCount', {}) is map
          && request.resource.data.get('unreadCount', {}).keys().hasOnly([
            resource.data.participantIds[0],
            resource.data.participantIds[1]
          ])
        )
        || unreadCountResetIsSafe()
        || sendMetadataIsAtomic()
        || sendMetadataIsAtomicByMessageId()
      );

      allow delete: if isParticipant();

      match /messageOps/{userId} {
        function parentConversationIsAccessible() {
          let conversation = get(
            /databases/$(database)/documents/conversations/$(conversationId)
          );
          return isAuthenticated()
            && conversation != null
            && conversation.data.participantIds is list
            && conversation.data.participantIds.hasAny([request.auth.uid]);
        }

        allow read, delete: if false;

        allow create, update: if isUser(userId)
          && parentConversationIsAccessible()
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.type == 'send'
          && request.resource.data.targetId is string
          && !exists(messagePath(request.resource.data.targetId))
          && existsAfter(messagePath(request.resource.data.targetId))
          && getAfter(messagePath(request.resource.data.targetId)).data.senderId == request.auth.uid;
      }

      match /typing/{typingUserId} {
        allow read: if canAccessConversation();

        allow create, update: if canAccessConversation()
          && typingUserId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'typing', 'updatedAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt is timestamp;

        allow delete: if canAccessConversation() && typingUserId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read: if canAccessConversation();

        allow create, update: if canAccessConversation()
          && request.resource.data.keys().hasOnly([
            'messageId',
            'userId',
            'emoji',
            'updatedAt'
          ])
          && request.resource.data.messageId is string
          && exists(
            /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.messageId)
          )
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🔥']
          && request.resource.data.updatedAt is timestamp;

        allow delete: if canAccessConversation()
          && resource.data.userId == request.auth.uid;
      }

      match /messages/{messageId} {
        function parentConversationIsAccessible() {
          let conversation = get(
            /databases/$(database)/documents/conversations/$(conversationId)
          );
          return isAuthenticated()
            && conversation != null
            && conversation.data.participantIds is list
            && conversation.data.participantIds.hasAny([request.auth.uid]);
        }

        function validMessageFields() {
          return request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'imageUrl',
            'createdAt',
            'status',
            'replyToMessageId',
            'replyToText',
            'isDeleted',
            'editedAt',
            'deletedAt',
            'deletedBy'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && request.resource.data.status == 'sent'
          && (
            !request.resource.data.keys().hasAny(['isDeleted'])
            || request.resource.data.isDeleted == false
          )
          && (
            !request.resource.data.keys().hasAny(['editedAt'])
            || request.resource.data.editedAt == null
          )
          && (
            !request.resource.data.keys().hasAny(['deletedAt'])
            || request.resource.data.deletedAt == null
          )
          && (
            !request.resource.data.keys().hasAny(['deletedBy'])
            || request.resource.data.deletedBy == null
          )
          && (
            !request.resource.data.keys().hasAny(['replyToMessageId'])
            || request.resource.data.replyToMessageId == null
            || request.resource.data.replyToMessageId is string
          )
          && (
            !request.resource.data.keys().hasAny(['replyToText'])
            || request.resource.data.replyToText == null
            || request.resource.data.replyToText is string
          )
          && (
            request.resource.data.text == null
            || request.resource.data.text is string
          )
          && (
            request.resource.data.imageUrl == null
            || request.resource.data.imageUrl is string
          )
          && (
            (
              request.resource.data.text is string
              && request.resource.data.text != ''
            )
            || (
              request.resource.data.imageUrl is string
              && request.resource.data.imageUrl != ''
            )
          );
        }

        function sendMarkerMatchesMessage() {
          let opAfter = getAfter(messageOpPath(request.auth.uid));
          return opAfter != null
            && opAfter.data.type == 'send'
            && opAfter.data.targetId == messageId
            && !exists(messagePath(messageId))
            && existsAfter(messagePath(messageId));
        }

        allow read: if parentConversationIsAccessible();

        allow create: if parentConversationIsAccessible()
          && validMessageFields();

        // Individual message deletion is not permitted. Conversation deletion
        // is the only client-side deletion path and must delete messages and
        // the parent conversation in the same batch.
        allow delete: if parentConversationIsAccessible()
          && !existsAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          );

        allow update: if parentConversationIsAccessible() && (
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == resource.data.status
            && (
              !request.resource.data.keys().hasAny(['isDeleted'])
              || request.resource.data.isDeleted == false
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'imageUrl', 'editedAt'])
            && (
              !request.resource.data.keys().hasAny(['editedAt'])
              || request.resource.data.editedAt == null
              || request.resource.data.editedAt == request.time
            )
            && (
              request.resource.data.text == null
              || request.resource.data.text is string
            )
            && (
              request.resource.data.imageUrl == null
              || request.resource.data.imageUrl is string
            )
            && (
              (
                request.resource.data.text is string
                && request.resource.data.text != ''
              )
              || (
                request.resource.data.imageUrl is string
                && request.resource.data.imageUrl != ''
              )
            )
          )
          || (
            resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'imageUrl',
              'isDeleted',
              'deletedAt',
              'deletedBy'
            ])
            && request.resource.data.isDeleted == true
            && request.resource.data.deletedBy == request.auth.uid
            && request.resource.data.deletedAt == request.time
            && request.resource.data.text == null
            && request.resource.data.imageUrl == null
          )
          || (
            resource.data.senderId != request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.text == resource.data.text
            && request.resource.data.imageUrl == resource.data.imageUrl
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              request.resource.data.status == 'delivered'
              || request.resource.data.status == 'read'
            )
            && (
              resource.data.status == 'sent'
              || resource.data.status == 'delivered'
            )
          )
        );
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid;

      // Recipients may only change the read status of their notification.
      allow update: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;

      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
    }
  }
}
