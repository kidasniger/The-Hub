rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- USERNAMES (Garantie d'unicité globale robuste) ---
    match /usernames/{usernameLower} {
      allow read: if isAuthenticated();
      // Un utilisateur ne peut réserver que son propre nom d'utilisateur
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Ne peut modifier ou libérer que son propre nom d'utilisateur
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // --- UTILISATEURS & PROFILS ---
    match /users/{userId} {
      // Lecture ouverte aux utilisateurs connectés (recherche, profils, flux)
      allow read: if isAuthenticated();

      // Création de son propre profil à l'inscription
      allow create: if isUser(userId) && request.resource.data.uid == userId;

      // Mise à jour :
      // 1. Soit l'utilisateur met à jour son propre profil (interdiction de modifier son uid ou de falsifier des rôles)
      // 2. Soit un tiers incrémente/décrémente légitimement followersCount lors d'un follow/unfollow
      // 3. Soit l'utilisateur supprime/désactive son propre compte (isDeleted: true)
      allow update: if isAuthenticated() && (
        (isUser(userId) && request.resource.data.uid == userId)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
          && (
            request.resource.data.followersCount == resource.data.followersCount + 1
            || request.resource.data.followersCount == resource.data.followersCount - 1
            || (resource.data.followersCount == null && request.resource.data.followersCount == 1)
          )
        )
      );

      // Suppression de son propre document utilisateur
      allow delete: if isUser(userId);

      // Utilisateurs bloqués : seul l'utilisateur peut gérer sa liste de blocage
      match /blockedUsers/{blockedId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow write: if isUser(userId);
      }

      // Followers : un utilisateur ne peut ajouter ou retirer que LUI-MÊME comme follower
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == followerId || isUser(userId));
      }

      // Following : seul l'utilisateur peut modifier les comptes qu'IL suit
      match /following/{followingId} {
        allow read: if isAuthenticated();
        allow write: if isUser(userId);
      }

      // Friends (relations réciproques) : modifiable uniquement par les deux parties concernées
      match /friends/{friendId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isUser(userId) || request.auth.uid == friendId);
      }

      // Signets (Bookmarks) : strictement privés à l'utilisateur
      match /bookmarks/{bookmarkId} {
        allow read, write: if isUser(userId);
      }
    }

    // --- SIGNALEMENTS (REPORTS) ---
    match /reports/{reportId} {
      // Tout utilisateur connecté peut créer un signalement, mais DOIT être l'auteur
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      // Aucun utilisateur client ne peut lire, modifier ou supprimer les signalements
      allow read, update, delete: if false;
    }

    // --- PUBLICATIONS, LIKES & COMMENTAIRES ---
    match /posts/{postId} {
      // Lecture ouverte aux utilisateurs connectés
      allow read: if isAuthenticated();

      // Création réservée à l'auteur authentifié
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;

      // Suppression réservée à l'auteur du post
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Mise à jour :
      // 1. L'auteur peut modifier le contenu de son post (sans falsifier authorId ou createdAt)
      // 2. Les autres utilisateurs connectés ne peuvent mettre à jour QUE les compteurs d'interaction (likesCount, commentsCount, repostsCount)
      allow update: if isAuthenticated() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostsCount']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'repostsCount']))
      );

      // Sous-collection des mentions J'aime d'un post
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isUser(userId);
      }

      // Sous-collection des commentaires
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;

        // Suppression autorisée à l'auteur du commentaire OU à l'auteur de la publication parent
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );

        // Mise à jour : auteur du commentaire modifiant son texte, ou mise à jour du compteur likesCount
        allow update: if isAuthenticated() && (
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt'])
          )
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']))
        );

        // Sous-collection des mentions J'aime sur un commentaire
        match /likes/{userId} {
          allow read: if isAuthenticated();
          allow write: if isUser(userId);
        }
      }
    }

    // --- MESSAGERIE & CONVERSATIONS DIRECTES (SÉCURITÉ STRICTE) ---
    match /conversations/{conversationId} {
      // Seuls les participants de la conversation peuvent la lire
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);

      // Création autorisée uniquement si l'utilisateur courant fait partie des 2 participants
      allow create: if isAuthenticated()
        && (request.auth.uid in request.resource.data.participantIds)
        && request.resource.data.participantIds.size() == 2;

      // Mise à jour autorisée uniquement pour les participants (interdiction formelle de modifier la liste des participants)
      allow update: if isAuthenticated()
        && (request.auth.uid in resource.data.participantIds)
        && (request.resource.data.participantIds == resource.data.participantIds);

      // Suppression autorisée uniquement aux participants
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);

      // Messages d'une conversation
      match /messages/{messageId} {
        // Lecture : uniquement par les participants de la conversation parente
        allow read: if isAuthenticated()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);

        // Création : uniquement par un participant, en tant qu'expéditeur authentique
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);

        // Mise à jour :
        // 1. Expéditeur modifiant son message
        // 2. Ou destinataire marquant le statut en lu ("status")
        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid
          || (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

        // Suppression : réservée à l'expéditeur du message
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      // Seul le destinataire peut lire, marquer comme lue ou supprimer ses notifications
      allow read, update, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;

      // Création : l'acteur DOIT être l'utilisateur connecté et ne peut pas se notifier lui-même
      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
    }
  }
}
